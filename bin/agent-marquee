#!/usr/bin/env python3
"""Start the AgentMarquee desktop program."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
if len(sys.argv) >= 2 and sys.argv[1] == "--hook-adapter":
    from agent_marquee.emit import main as emit_main
    raise SystemExit(emit_main(["--adapter", *sys.argv[2:]]))
if len(sys.argv) >= 2 and sys.argv[1] == "--send":
    from agent_marquee.send import main as send_main
    raise SystemExit(send_main(sys.argv[2:]))
if sys.platform != "darwin":
    raise SystemExit("AgentMarquee desktop display currently requires macOS")

from agent_marquee.display.macos import main

raise SystemExit(main())
